PORT=5000
# MongoDB Atlas (설정 시 우선 사용)
MONGODB_ATLAS_URL=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/shoping-mall-demo?retryWrites=true&w=majority
# SRV DNS 오류 시(Windows): 8.8.8.8,8.8.4.4 등 (기본값 자동 적용)
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
# Atlas URL이 없을 때만 사용 — 로컬: 저장소 루트에서 docker compose up -d
MONGODB_URI=mongodb://127.0.0.1:27017/shoping-mall

# JWT (로그인 토큰). 운영에서는 긴 무작위 문자열로 반드시 교체
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS 허용 출처(쉼표 구분). 비우면 요청 Origin을 그대로 허용(로컬 개발에 적합)
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 포트원 결제 검증 (관리자 콘솔 > 연동 정보 > REST API)
PORTONE_API_KEY=your-rest-api-key
PORTONE_API_SECRET=your-rest-api-secret
# 클라이언트 IMP.init 에 사용하는 가맹점 식별코드
PORTONE_STORE_ID=imp54300850
