# ─── API (상품 등록 POST /api/products) ───────────────
VITE_API_BASE_URL=http://localhost:5000

# ─── Cloudinary Upload Widget (Unsigned) ─────────────
# https://cloudinary.com/console
#
# 1) Cloud name
#    대시보드 우측 또는 Settings → Product environment credentials
VITE_CLOUDINARY_CLOUD_NAME=

# 2) Upload preset (반드시 Unsigned)
#    Settings → Upload → Upload presets → Add upload preset
#    Signing Mode: Unsigned
VITE_CLOUDINARY_UPLOAD_PRESET=

# 3) (선택) 업로드할 폴더 경로
# VITE_CLOUDINARY_FOLDER=shoping-mall/products
